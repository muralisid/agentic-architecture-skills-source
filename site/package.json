{
  "name": "agentic-enterprise-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "build": "npm run guard && npm run sync && npm run figures:export && npm run diagrams && npm run validate && next build",
    "dev": "npm run sync && next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "guard": "node scripts/prebuild-guard.mjs",
    "figures:export": "node scripts/export-figures.mjs",
    "validate": "npm run validate:content && npm run validate:figures",
    "validate:content": "node ../scripts/check-content.mjs",
    "validate:figures": "node scripts/validate-figures.mjs",
    "diagrams": "node scripts/build-wall-chart.mjs"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "^16.14.5",
    "fumadocs-mdx": "^15.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.5",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
